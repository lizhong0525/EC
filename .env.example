# Copy to .env.local (never commit the local copy).
LITELLM_BASE_URL=https://litellm.dex-gem.ai/v1
LITELLM_API_KEY=

# Set this for immediate Web/API smoke testing. Formal Benchmark runs should
# use a qualified artifacts/models/model_snapshot.json instead.
ECO_DEFAULT_MODEL=

# Optional accounting fields (recommended for experiments).
ECO_MODEL_INPUT_PRICE_CNY_PER_MILLION=
ECO_MODEL_OUTPUT_PRICE_CNY_PER_MILLION=
ECO_MODEL_PRICING_VERSION=
ECO_API_BUDGET_CNY=5000
ECO_RESEARCH_MODE=true
