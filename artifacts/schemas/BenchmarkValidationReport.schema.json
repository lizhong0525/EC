        "compared_pair_count": {
          "minimum": 0,
          "title": "Compared Pair Count",
          "type": "integer"
        },
        "maximum_jaccard": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Maximum Jaccard",
          "type": "number"
        },
        "pairs_at_or_above_threshold": {
          "minimum": 0,
          "title": "Pairs At Or Above Threshold",
          "type": "integer"
        },
        "worst_left": {
          "anyOf": [
            {
              "$ref": "#/$defs/TextReferenceV1"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "worst_right": {
          "anyOf": [
            {
              "$ref": "#/$defs/TextReferenceV1"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "left_split",
        "right_split",
        "kind",
        "compared_pair_count",
        "maximum_jaccard",
        "pairs_at_or_above_threshold"
      ],
      "title": "CrossSplitSimilarityV1",
      "type": "object"
    },
    "DatasetSplit": {
      "enum": [
        "train",
        "dev",
        "public_test",
        "hidden_test"
