          "type": "string"
        },
        "ngram_size": {
          "minimum": 1,
          "title": "Ngram Size",
          "type": "integer"
        },
        "threshold": {
          "exclusiveMinimum": 0.0,
          "maximum": 1.0,
          "title": "Threshold",
          "type": "number"
        },
        "comparisons": {
