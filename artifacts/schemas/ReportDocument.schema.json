    "StatisticalProtocolRecord": {
      "additionalProperties": false,
      "description": "Frozen statistical protocol embedded in every paper-facing report.",
      "properties": {
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "confidence_level": {
          "default": 0.95,
          "exclusiveMaximum": 1.0,
          "exclusiveMinimum": 0.0,
          "title": "Confidence Level",
          "type": "number"
        },
        "bootstrap_resamples": {
          "default": 2000,
          "exclusiveMinimum": 0,
          "title": "Bootstrap Resamples",
          "type": "integer"
        },
        "permutation_resamples": {
          "default": 10000,
          "exclusiveMinimum": 0,
          "title": "Permutation Resamples",
          "type": "integer"
        },
        "random_seed": {
          "default": 20260904,
          "title": "Random Seed",
          "type": "integer"
        },
        "cluster_unit": {
          "minLength": 1,
          "title": "Cluster Unit",
          "type": "string"
        },
        "repeated_measure_handling": {
          "minLength": 1,
          "title": "Repeated Measure Handling",
          "type": "string"
        },
        "paired_unit": {
          "minLength": 1,
          "title": "Paired Unit",
          "type": "string"
        },
        "paired_test": {
          "const": "two-sided exact-or-monte-carlo sign-flip",
          "default": "two-sided exact-or-monte-carlo sign-flip",
          "title": "Paired Test",
          "type": "string"
        },
        "effect_size": {
          "const": "paired Cohen dz",
          "default": "paired Cohen dz",
          "title": "Effect Size",
          "type": "string"
        }
      },
      "required": [
        "cluster_unit",
        "repeated_measure_handling",
        "paired_unit"
      ],
      "title": "StatisticalProtocolRecord",
      "type": "object"
    },
    "Track": {
      "enum": [
        "A",
        "B",
        "C"
      ],
      "title": "Track",
      "type": "string"
    }
  },
  "additionalProperties": false,
