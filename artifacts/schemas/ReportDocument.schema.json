{
  "$defs": {
    "Action": {
      "enum": [
        "SUPPORTIVE_LISTENING",
        "CLARIFY_SYMPTOMS",
        "DIRECT_SAFETY_CHECK",
        "LOW_RISK_COPING",
        "TRUSTED_ADULT_BRIDGE",
        "SCHOOL_SUPPORT",
        "PROFESSIONAL_ASSESSMENT",
        "URGENT_ESCALATION",
        "BOUNDARY_CLARIFICATION",
        "PRIVACY_CLARIFICATION"
      ],
      "title": "Action",
      "type": "string"
    },
    "EvidenceScoringRecord": {
      "additionalProperties": false,
      "description": "Provenance and availability of Track A expert-evidence scoring.",
      "properties": {
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "status": {
          "enum": [
            "NO_GOLD_ANNOTATION",
            "VALIDATED_ADJUDICATED_GOLD",
            "LEGACY_CODES_ONLY",
            "MIXED_EVIDENCE_FORMAT"
          ],
          "title": "Status",
          "type": "string"
        },
        "annotation_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Annotation Path"
        },
        "annotation_digest": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Annotation Digest"
        },
        "batch_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Batch Id"
        },
        "manual_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Manual Version"
        },
        "dataset_digest": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dataset Digest"
        },
        "gold_node_count": {
          "default": 0,
          "minimum": 0,
          "title": "Gold Node Count",
          "type": "integer"
        },
        "full_reference_record_count": {
          "default": 0,
          "minimum": 0,
          "title": "Full Reference Record Count",
          "type": "integer"
        },
        "legacy_record_count": {
          "default": 0,
          "minimum": 0,
          "title": "Legacy Record Count",
          "type": "integer"
        }
      },
      "required": [
        "status"
      ],
      "title": "EvidenceScoringRecord",
      "type": "object"
    },
    "FailureCaseRecord": {
      "additionalProperties": false,
      "description": "Ranked, auditable failure extracted from an immutable result unit.",
      "properties": {
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "failure_id": {
          "minLength": 1,
          "title": "Failure Id",
          "type": "string"
        },
        "rank": {
          "exclusiveMinimum": 0,
          "title": "Rank",
          "type": "integer"
        },
        "track": {
          "$ref": "#/$defs/Track"
        },
        "severity_score": {
          "exclusiveMinimum": 0.0,
          "title": "Severity Score",
          "type": "number"
        },
        "system_name": {
          "minLength": 1,
          "title": "System Name",
          "type": "string"
        },
        "unit_id": {
          "minLength": 1,
          "title": "Unit Id",
          "type": "string"
        },
        "case_or_scenario_id": {
          "minLength": 1,
          "title": "Case Or Scenario Id",
          "type": "string"
        },
        "pair_key": {
          "minLength": 1,
          "title": "Pair Key",
          "type": "string"
        },
        "step_or_turn_index": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Step Or Turn Index"
        },
        "surface_index": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Surface Index"
        },
        "repeat_index": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Repeat Index"
        },
        "seed": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Seed"
        },
        "issue_codes": {
          "items": {
            "type": "string"
          },
          "title": "Issue Codes",
          "type": "array"
        },
        "message_excerpt": {
          "title": "Message Excerpt",
          "type": "string"
        },
        "response_excerpt": {
          "title": "Response Excerpt",
          "type": "string"
        },
        "reference_value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reference Value"
        },
        "predicted_value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Predicted Value"
        },
        "selected_action": {
          "anyOf": [
            {
              "$ref": "#/$defs/Action"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "violation_codes": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Violation Codes",
          "type": "array"
        }
      },
      "required": [
        "failure_id",
        "rank",
        "track",
        "severity_score",
        "system_name",
        "unit_id",
        "case_or_scenario_id",
        "pair_key",
        "issue_codes",
        "message_excerpt",
        "response_excerpt"
      ],
      "title": "FailureCaseRecord",
      "type": "object"
    },
    "MetricEstimateRecord": {
      "additionalProperties": false,
      "description": "Point estimate and canonical-cluster percentile confidence interval.",
      "properties": {
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "estimate": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Estimate"
        },
        "ci_lower": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Ci Lower"
        },
        "ci_upper": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Ci Upper"
        },
        "confidence_level": {
          "exclusiveMaximum": 1.0,
          "exclusiveMinimum": 0.0,
          "title": "Confidence Level",
          "type": "number"
        },
        "cluster_count": {
          "exclusiveMinimum": 0,
          "title": "Cluster Count",
          "type": "integer"
        },
        "bootstrap_resamples": {
          "exclusiveMinimum": 0,
          "title": "Bootstrap Resamples",
          "type": "integer"
        },
        "valid_bootstrap_resamples": {
          "minimum": 0,
          "title": "Valid Bootstrap Resamples",
          "type": "integer"
        },
        "bootstrap_seed": {
          "title": "Bootstrap Seed",
          "type": "integer"
        }
      },
      "required": [
        "estimate",
        "ci_lower",
        "ci_upper",
        "confidence_level",
        "cluster_count",
        "bootstrap_resamples",
        "valid_bootstrap_resamples",
        "bootstrap_seed"
      ],
      "title": "MetricEstimateRecord",
      "type": "object"
    },
    "PairedComparisonRecord": {
      "additionalProperties": false,
      "description": "Versioned paired result; every difference is ``left - right``.",
      "properties": {
        "schema_version": {
          "const": "1.1",
          "default": "1.1",
          "title": "Schema Version",
          "type": "string"
        },
        "metric_name": {
          "minLength": 1,
          "title": "Metric Name",
          "type": "string"
        },
        "left_name": {
          "minLength": 1,
          "title": "Left Name",
          "type": "string"
        },
        "right_name": {
          "minLength": 1,
          "title": "Right Name",
          "type": "string"
        },
        "pair_unit": {
          "minLength": 1,
          "title": "Pair Unit",
          "type": "string"
        },
        "higher_is_better": {
          "title": "Higher Is Better",
          "type": "boolean"
        },
        "matched_pair_count": {
          "exclusiveMinimum": 0,
          "title": "Matched Pair Count",
          "type": "integer"
        },
        "cluster_count": {
          "exclusiveMinimum": 0,
          "title": "Cluster Count",
          "type": "integer"
        },
        "pair_count": {
          "exclusiveMinimum": 0,
          "title": "Pair Count",
          "type": "integer"
        },
        "effective_pair_count": {
          "minimum": 0,
          "title": "Effective Pair Count",
          "type": "integer"
        },
        "mean_difference": {
          "title": "Mean Difference",
          "type": "number"
        },
        "median_difference": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Median Difference"
        },
        "ci_lower": {
          "title": "Ci Lower",
          "type": "number"
        },
        "ci_upper": {
          "title": "Ci Upper",
          "type": "number"
        },
        "cohen_dz": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Cohen Dz"
        },
        "raw_p_value": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Raw P Value",
          "type": "number"
        },
        "holm_adjusted_p_value": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Holm Adjusted P Value",
          "type": "number"
        },
        "p_value": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "P Value",
          "type": "number"
        },
        "comparison_family": {
          "minLength": 1,
          "title": "Comparison Family",
          "type": "string"
        },
        "primary_endpoint": {
          "default": false,
          "title": "Primary Endpoint",
          "type": "boolean"
        },
        "left_only_count": {
          "default": 0,
          "minimum": 0,
          "title": "Left Only Count",
          "type": "integer"
        },
        "right_only_count": {
          "default": 0,
          "minimum": 0,
          "title": "Right Only Count",
          "type": "integer"
        },
        "complete_pairing": {
          "default": true,
          "title": "Complete Pairing",
          "type": "boolean"
        },
        "test_method": {
          "enum": [
            "all_ties",
            "exact_sign_flip",
            "monte_carlo_sign_flip"
          ],
          "title": "Test Method",
          "type": "string"
        },
        "win_count": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Win Count"
        },
        "tie_count": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tie Count"
        },
        "loss_count": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Loss Count"
        },
        "bootstrap_resamples": {
          "exclusiveMinimum": 0,
          "title": "Bootstrap Resamples",
          "type": "integer"
        },
        "permutation_resamples": {
          "exclusiveMinimum": 0,
          "title": "Permutation Resamples",
          "type": "integer"
        },
        "random_seed": {
          "title": "Random Seed",
          "type": "integer"
        }
      },
      "required": [
        "metric_name",
        "left_name",
        "right_name",
        "pair_unit",
        "higher_is_better",
        "matched_pair_count",
        "cluster_count",
        "pair_count",
        "effective_pair_count",
        "mean_difference",
        "median_difference",
        "ci_lower",
        "ci_upper",
        "cohen_dz",
        "raw_p_value",
        "holm_adjusted_p_value",
        "p_value",
        "comparison_family",
        "test_method",
        "bootstrap_resamples",
        "permutation_resamples",
        "random_seed"
      ],
      "title": "PairedComparisonRecord",
      "type": "object"
    },
