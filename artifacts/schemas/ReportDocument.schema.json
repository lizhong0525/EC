        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Planned Unit Count"
    },
    "complete": {
      "title": "Complete",
      "type": "boolean"
    },
    "statistical_protocol": {
      "$ref": "#/$defs/StatisticalProtocolRecord"
