{
  "$defs": {
    "InteractiveModelBindingRecord": {
      "additionalProperties": false,
      "description": "One exact model/family assignment frozen for an interactive role.",
      "properties": {
        "role": {
          "$ref": "#/$defs/ModelRole"
        },
        "model_id": {
          "minLength": 1,
          "title": "Model Id",
          "type": "string"
        },
        "family": {
          "minLength": 1,
          "title": "Family",
          "type": "string"
        },
        "allowed_response_model_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Allowed Response Model Ids",
          "type": "array"
        }
      },
      "required": [
        "role",
        "model_id",
        "family"
      ],
      "title": "InteractiveModelBindingRecord",
      "type": "object"
    },
    "InteractiveRuntimeRecord": {
      "additionalProperties": false,
      "description": "Complete local or formal API identity for a Track B/C run.",
      "properties": {
        "mode": {
          "enum": [
            "local",
            "formal_api"
          ],
          "title": "Mode",
          "type": "string"
        },
        "renderer_name": {
          "minLength": 1,
          "title": "Renderer Name",
          "type": "string"
        },
        "responder_name": {
          "minLength": 1,
          "title": "Responder Name",
          "type": "string"
        },
        "role_bindings": {
          "default": [],
          "items": {
            "$ref": "#/$defs/InteractiveModelBindingRecord"
          },
          "title": "Role Bindings",
          "type": "array"
        },
        "model_snapshot_digest": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Snapshot Digest"
        },
        "pricing_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pricing Version"
        },
        "pricing_catalog_digest": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pricing Catalog Digest"
        },
        "qualification_suite_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Qualification Suite Version"
        },
        "gateway_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Gateway Name"
        },
        "gateway_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Gateway Version"
        },
        "adapter_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Adapter Name"
        },
        "adapter_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Adapter Version"
        },
        "decoder_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Decoder Version"
        },
        "cache_schema_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cache Schema Version"
        },
        "trace_schema_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Trace Schema Version"
        },
        "prompt_identities": {
          "default": [],
          "items": {
            "$ref": "#/$defs/PromptIdentityRecord"
          },
          "title": "Prompt Identities",
          "type": "array"
        },
        "api_budget_cny": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "maximum": 5000.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Api Budget Cny"
        }
      },
      "required": [
        "mode",
        "renderer_name",
        "responder_name"
      ],
      "title": "InteractiveRuntimeRecord",
      "type": "object"
    },
    "ModelRole": {
      "enum": [
        "evaluated_agent",
        "student_simulator",
        "judge"
      ],
      "title": "ModelRole",
      "type": "string"
    },
    "PolicyFamily": {
      "enum": [
        "diagnostic_baseline",
        "llm_baseline",
        "rule_agent",
        "eco_safe",
        "eco_safe_ablation"
      ],
      "title": "PolicyFamily",
      "type": "string"
    },
    "PolicyRuntimeRecord": {
      "additionalProperties": false,
      "description": "Secret-free policy implementation and model provenance.",
      "properties": {
        "policy_name": {
          "minLength": 1,
          "title": "Policy Name",
          "type": "string"
        },
        "family": {
          "$ref": "#/$defs/PolicyFamily"
        },
        "implementation_version": {
          "minLength": 1,
          "title": "Implementation Version",
          "type": "string"
        },
        "prompt_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Prompt Version"
        },
        "provider_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provider Name"
        },
        "model_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Id"
        },
        "model_snapshot_digest": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Snapshot Digest"
        },
        "pricing_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pricing Version"
        },
        "input_price_cny_per_million": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Input Price Cny Per Million"
        },
        "output_price_cny_per_million": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Output Price Cny Per Million"
        },
        "api_budget_cny": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "maximum": 5000.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Api Budget Cny"
        },
        "enabled_features": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Enabled Features",
          "type": "array"
        },
        "ablated_component": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ablated Component"
        }
      },
      "required": [
        "policy_name",
        "family",
        "implementation_version"
      ],
      "title": "PolicyRuntimeRecord",
      "type": "object"
    },
    "PromptIdentityRecord": {
      "additionalProperties": false,
      "description": "Version and content digest for one provider-facing prompt.",
      "properties": {
        "component": {
          "minLength": 1,
          "title": "Component",
          "type": "string"
        },
        "version": {
          "minLength": 1,
          "title": "Version",
          "type": "string"
        },
        "digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        }
      },
      "required": [
        "component",
        "version",
        "digest"
      ],
      "title": "PromptIdentityRecord",
      "type": "object"
    },
    "TrackBEpisodeSpecRecord": {
      "additionalProperties": false,
      "description": "Frozen Track B episode selection embedded in a run manifest.",
      "properties": {
        "episode_id": {
          "minLength": 1,
          "title": "Episode Id",
          "type": "string"
        },
        "case_id": {
          "minLength": 1,
          "title": "Case Id",
          "type": "string"
        },
        "seed": {
          "title": "Seed",
          "type": "integer"
        },
        "surface_index": {
          "minimum": 0,
          "title": "Surface Index",
          "type": "integer"
        },
        "turn_limit": {
          "minimum": 1,
          "title": "Turn Limit",
          "type": "integer"
        }
      },
      "required": [
        "episode_id",
        "case_id",
        "seed",
        "surface_index",
        "turn_limit"
      ],
      "title": "TrackBEpisodeSpecRecord",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Write-once description of one interactive Track B run.",
  "properties": {
    "schema_version": {
      "const": "1.2",
      "default": "1.2",
      "title": "Schema Version",
      "type": "string"
    },
    "run_id": {
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "benchmark_version": {
      "title": "Benchmark Version",
      "type": "string"
    },
    "track": {
      "const": "B",
      "default": "B",
      "title": "Track",
      "type": "string"
    },
    "dataset_seed": {
      "title": "Dataset Seed",
      "type": "integer"
    },
    "dataset_path": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Dataset Path"
    },
    "dataset_digest": {
      "title": "Dataset Digest",
      "type": "string"
    },
    "selection_seed": {
      "title": "Selection Seed",
      "type": "integer"
    },
    "policy_names": {
      "items": {
        "type": "string"
      },
      "title": "Policy Names",
      "type": "array"
    },
    "policy_runtimes": {
      "items": {
        "$ref": "#/$defs/PolicyRuntimeRecord"
      },
      "title": "Policy Runtimes",
      "type": "array"
    },
    "renderer_name": {
      "minLength": 1,
      "title": "Renderer Name",
      "type": "string"
    },
    "interactive_runtime": {
      "$ref": "#/$defs/InteractiveRuntimeRecord"
    },
    "selected_case_ids": {
      "items": {
        "type": "string"
      },
      "title": "Selected Case Ids",
      "type": "array"
    },
    "episode_specs": {
      "items": {
        "$ref": "#/$defs/TrackBEpisodeSpecRecord"
      },
      "title": "Episode Specs",
      "type": "array"
    },
    "planned_unit_ids": {
      "items": {
        "type": "string"
      },
      "title": "Planned Unit Ids",
      "type": "array"
    },
    "run_fingerprint": {
      "title": "Run Fingerprint",
      "type": "string"
    }
  },
  "required": [
    "run_id",
    "benchmark_version",
    "dataset_seed",
    "dataset_digest",
    "selection_seed",
    "policy_names",
    "policy_runtimes",
    "renderer_name",
    "interactive_runtime",
    "selected_case_ids",
    "episode_specs",
    "planned_unit_ids",
    "run_fingerprint"
  ],
  "title": "TrackBExperimentManifest",
  "type": "object"
}